@{
    ViewData["Title"] = "Courses & Fees";
}

<div class="text-center mb-5">
    <h2 class="fw-bold text-primary">Our Professional Courses & Fee Structure</h2>
    <p class="text-muted">Aasan iqsat (installments) ke sath apne pasandeeda professional course mein admission lein.</p>
</div>

<div class="row g-4">
    <!-- 1. Digital Marketing Course -->
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 rounded-4">
            <div class="card-header bg-primary text-white text-center py-3 rounded-top-4">
                <h5 class="mb-0 fw-bold"><i class="fas fa-bullhorn me-2"></i> Digital Marketing</h5>
            </div>
            <div class="card-body p-4">
                <span class="badge bg-info text-dark mb-3">Duration: 3 Months</span>
                <h4 class="text-success fw-bold mb-3">Rs. 24,000 <span class="fs-6 text-muted fw-normal">Total Fee</span></h4>
                <p class="text-dark"><strong>Monthly Installment:</strong> Rs. 8,000 / month</p>
                <hr>
                <p class="fw-bold text-dark mb-2">Tafseel (Modules):</p>
                <ul class="list-unstyled small text-muted">
                    <li><i class="fas fa-check text-success me-2"></i> Social Media Marketing & Strategy</li>
                    <li><i class="fas fa-check text-success me-2"></i> Facebook & Instagram Paid Ads (Meta Ads)</li>
                    <li><i class="fas fa-check text-success me-2"></i> TikTok Ads & YouTube Promotion</li>
                    <li><i class="fas fa-check text-success me-2"></i> Google Ads (Search & Display)</li>
                    <li><i class="fas fa-check text-success me-2"></i> Email Marketing & Cold Emailing Strategies</li>
                    <li><i class="fas fa-check text-success me-2"></i> Search Engine Optimization (SEO Basics)</li>
                    <li><i class="fas fa-check text-success me-2"></i> Lead Generation & Client Hunting</li>
                    <li><i class="fas fa-check text-success me-2"></i> Canva & Basic Graphics for Marketing</li>
                </ul>
            </div>
            <div class="card-footer bg-white border-0 text-center pb-4">
                <a href="/Home/Admission" class="btn btn-outline-primary w-100 fw-bold">Apply For This Course</a>
            </div>
        </div>
    </div>

    <!-- 2. Full Stack Web Development (ASP.NET Core & MySQL) Course -->
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 rounded-4">
            <div class="card-header bg-success text-white text-center py-3 rounded-top-4">
                <h5 class="mb-0 fw-bold"><i class="fas fa-code me-2"></i> ASP.NET Core & MySQL</h5>
            </div>
            <div class="card-body p-4">
                <span class="badge bg-warning text-dark mb-3">Duration: 3 Months</span>
                <h4 class="text-success fw-bold mb-3">Rs. 60,000 <span class="fs-6 text-muted fw-normal">Total Fee</span></h4>
                <p class="text-dark"><strong>Monthly Installment:</strong> Rs. 20,000 / month</p>
                <hr>
                <p class="fw-bold text-dark mb-2">Tafseel (Modules):</p>
                <ul class="list-unstyled small text-muted">
                    <li><i class="fas fa-check text-success me-2"></i> HTML5, CSS3, & Modern JavaScript</li>
                    <li><i class="fas fa-check text-success me-2"></i> Responsive UI Design with Bootstrap 5</li>
                    <li><i class="fas fa-check text-success me-2"></i> C# Programming Language Fundamentals</li>
                    <li><i class="fas fa-check text-success me-2"></i> ASP.NET Core MVC Architecture</li>
                    <li><i class="fas fa-check text-success me-2"></i> <strong>MySQL Database Integration & Queries</strong></li>
                    <li><i class="fas fa-check text-success me-2"></i> Entity Framework Core & Migrations</li>
                    <li><i class="fas fa-check text-success me-2"></i> User Authentication & Form Validations</li>
                    <li><i class="fas fa-check text-success me-2"></i> Live Project Deployment & Hosting</li>
                </ul>
            </div>
            <div class="card-footer bg-white border-0 text-center pb-4">
                <a href="/Home/Admission" class="btn btn-outline-success w-100 fw-bold">Apply For This Course</a>
            </div>
        </div>
    </div>

    <!-- 3. Office Management Course -->
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 rounded-4">
            <div class="card-header bg-dark text-white text-center py-3 rounded-top-4">
                <h5 class="mb-0 fw-bold"><i class="fas fa-laptop me-2"></i> Office Management</h5>
            </div>
            <div class="card-body p-4">
                <span class="badge bg-info text-dark mb-3">Duration: 2 Months</span>
                <h4 class="text-success fw-bold mb-3">Rs. 8,000 <span class="fs-6 text-muted fw-normal">Total Fee</span></h4>
                <p class="text-dark"><strong>Monthly Installment:</strong> Rs. 4,000 / month</p>
                <hr>
                <p class="fw-bold text-dark mb-2">Tafseel (Modules):</p>
                <ul class="list-unstyled small text-muted">
                    <li><i class="fas fa-check text-success me-2"></i> Microsoft Word (Typing, Formatting, Letters)</li>
                    <li><i class="fas fa-check text-success me-2"></i> Microsoft Excel (Sheets, Formulas, Salary Sheets)</li>
                    <li><i class="fas fa-check text-success me-2"></i> Microsoft PowerPoint (Professional Presentations)</li>
                    <li><i class="fas fa-check text-success me-2"></i> InPage Urdu Typing & Formatting</li>
                    <li><i class="fas fa-check text-success me-2"></i> Email, Gmail, & Professional Correspondence</li>
                    <li><i class="fas fa-check text-success me-2"></i> Office File Management & Scanning</li>
                </ul>
            </div>
            <div class="card-footer bg-white border-0 text-center pb-4">
                <a href="/Home/Admission" class="btn btn-outline-dark w-100 fw-bold">Apply For This Course</a>
            </div>
        </div>
    </div>
</div>