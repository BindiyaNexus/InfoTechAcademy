@{
    ViewData["Title"] = "Home";
}

<div class="p-5 mb-4 rounded-4 shadow-sm border text-center" style="background: linear-gradient(135deg, #1e3a8a, #0284c7); color: white;">
    <div class="container-fluid py-5">
        <h1 class="display-4 fw-bold mb-3">InfoTech Online Marketing Academy</h1>
        <p class="fs-4 mb-4 text-light"><strong>Learn Today | Build Tomorrow</strong></p>
        <p class="lead mb-4">Apne skills ko barhayein aur professional training ke sath kamyabi hasil karein!</p>
        <a href="/Home/Courses" class="btn btn-warning btn-lg fw-bold px-4 me-2 shadow"><i class="fas fa-book-reader me-2"></i> Explore Courses</a>
        <a href="/Home/Admission" class="btn btn-light btn-lg fw-bold px-4 shadow text-primary"><i class="fas fa-user-plus me-2"></i> Apply Online Now</a>
    </div>
</div>

<div class="row g-4 text-center">
    <div class="col-md-4">
        <div class="p-4 bg-white rounded-4 shadow-sm h-100 border">
            <i class="fas fa-chalkboard-teacher fa-3x text-primary mb-3"></i>
            <h5 class="fw-bold">Expert Trainers</h5>
            <p class="text-muted small">Professionally trained and experienced instructors to guide you step-by-step.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="p-4 bg-white rounded-4 shadow-sm h-100 border">
            <i class="fas fa-laptop-code fa-3x text-success mb-3"></i>
            <h5 class="fw-bold">Practical Training</h5>
            <p class="text-muted small">Hands-on live projects and modern computer lab facility for all students.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="p-4 bg-white rounded-4 shadow-sm h-100 border">
            <i class="fas fa-certificate fa-3x text-warning mb-3"></i>
            <h5 class="fw-bold">Certificate Provided</h5>
            <p class="text-muted small">Get a recognized course completion certificate after successfully finishing your training.</p>
        </div>
    </div>
</div>