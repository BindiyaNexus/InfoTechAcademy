@model InfoTechAcademy.Models.Admission

@{
    ViewData["Title"] = "Admission Form";
}

<div class="row justify-content-center">
    <div class="col-lg-10">

        <div class="text-center mb-4">
            <h2 class="fw-bold text-primary">Online Admission Form</h2>
            <p class="text-muted">Apni tamaam personal, contact aur educational details durust tareeqay se bharein.</p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- JazzCash Payment Box -->
        <div class="card bg-light border-warning border-2 shadow-sm mb-4 rounded-4">
            <div class="card-body p-4">
                <h5 class="fw-bold text-warning mb-2"><i class="fas fa-wallet me-2"></i> JazzCash Fee Deposit Account</h5>
                <p class="mb-1 fs-5"><strong>Account Number:</strong> <span class="text-danger fw-bold">0300-9789984</span></p>
                <p class="mb-0 fs-6"><strong>Account Title:</strong> <span class="text-dark fw-bold">Shahida Parveen</span></p>
                <small class="text-muted mt-2 d-block">* Pehle JazzCash par fee transfer karein aur phir niche Transaction ID enter karein.</small>
            </div>
        </div>

        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Admission" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Section 1: Personal Details -->
                    <h5 class="text-primary fw-bold mb-3 border-bottom pb-2"><i class="fas fa-user-circle me-2"></i> 1. Personal Information</h5>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FullName" class="form-label fw-semibold"></label>
                            <input asp-for="FullName" class="form-control" placeholder="Enter student full name" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="FatherName" class="form-label fw-semibold"></label>
                            <input asp-for="FatherName" class="form-control" placeholder="Enter father / guardian name" />
                            <span asp-validation-for="FatherName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="DateOfBirth" class="form-label fw-semibold"></label>
                            <input asp-for="DateOfBirth" class="form-control" type="date" />
                            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Gender" class="form-label fw-semibold"></label>
                            <select asp-for="Gender" class="form-select">
                                <option value="">-- Select Gender --</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                            <span asp-validation-for="Gender" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="CnicOrBForm" class="form-label fw-semibold"></label>
                            <input asp-for="CnicOrBForm" class="form-control" placeholder="31202-XXXXXXX-X" />
                            <span asp-validation-for="CnicOrBForm" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Qualification" class="form-label fw-semibold"></label>
                            <input asp-for="Qualification" class="form-control" placeholder="e.g. Matric / Intermediate / Graduate" />
                            <span asp-validation-for="Qualification" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Section 2: Contact Details -->
                    <h5 class="text-primary fw-bold mb-3 mt-4 border-bottom pb-2"><i class="fas fa-address-book me-2"></i> 2. Contact Information</h5>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="WhatsAppNumber" class="form-label fw-semibold"></label>
                            <input asp-for="WhatsAppNumber" class="form-control" placeholder="03XXXXXXXXX" />
                            <span asp-validation-for="WhatsAppNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ContactNumber" class="form-label fw-semibold"></label>
                            <input asp-for="ContactNumber" class="form-control" placeholder="03XXXXXXXXX" />
                            <span asp-validation-for="ContactNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <input asp-for="Email" class="form-control" placeholder="student@gmail.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Address" class="form-label fw-semibold"></label>
                            <input asp-for="Address" class="form-control" placeholder="House #, Street, City" />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Section 3: Course & Fee Details -->
                    <h5 class="text-primary fw-bold mb-3 mt-4 border-bottom pb-2"><i class="fas fa-graduation-cap me-2"></i> 3. Course & Fee Payment</h5>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label asp-for="SelectedCourse" class="form-label fw-semibold"></label>
                            <select asp-for="SelectedCourse" class="form-select">
                                <option value="">-- Choose Desired Course --</option>
                                <option value="Digital Marketing - Rs. 24,000 (8k/mo)">Digital Marketing (3 Months - Total Rs. 24,000 | Rs. 8,000/mo)</option>
                                <option value="Full Stack Web Development - Rs. 60,000 (20k/mo)">Full Stack Web Development (3 Months - Total Rs. 60,000 | Rs. 20,000/mo)</option>
                                <option value="Office Management - Rs. 8,000 (4k/mo)">Office Management (2 Months - Total Rs. 8,000 | Rs. 4,000/mo)</option>
                            </select>
                            <span asp-validation-for="SelectedCourse" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="PaymentStatus" class="form-label fw-semibold"></label>
                            <select asp-for="PaymentStatus" class="form-select">
                                <option value="">-- Select Status --</option>
                                <option value="Full Fee Advance Paid">Full Fee Advance Paid</option>
                                <option value="1st Installment Paid">1st Installment Paid</option>
                            </select>
                            <span asp-validation-for="PaymentStatus" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="PaymentMethod" class="form-label fw-semibold"></label>
                            <select asp-for="PaymentMethod" class="form-select">
                                <option value="">-- Select Method --</option>
                                <option value="JazzCash (Shahida Parveen)">JazzCash (Shahida Parveen)</option>
                                <option value="EasyPaisa">EasyPaisa</option>
                                <option value="Bank Transfer">Bank Transfer</option>
                            </select>
                            <span asp-validation-for="PaymentMethod" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="TransactionId" class="form-label fw-semibold"></label>
                            <input asp-for="TransactionId" class="form-control" placeholder="TID / Ref No." />
                            <span asp-validation-for="TransactionId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-primary btn-lg fw-bold shadow">
                            <i class="fas fa-paper-plane me-2"></i> Submit Complete Admission Form
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>