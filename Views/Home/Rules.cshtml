@{
    ViewData["Title"] = "Rules & Regulations";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-danger text-white text-center py-3 rounded-top-4">
                <h4 class="mb-0 fw-bold"><i class="fas fa-gavel me-2"></i> Academy Rules & Regulations</h4>
            </div>
            <div class="card-body p-4 p-md-5">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item py-3">
                        <i class="fas fa-check-circle text-success me-2"></i> <strong>Monthly Installment:</strong> Har mahine waqt per apni monthly qist  jama karwana lazmi hai.
                    </li>
                    <li class="list-group-item py-3">
                        <i class="fas fa-check-circle text-success me-2"></i> <strong>Fee Non-Refundable:</strong> Admission fee ya installment kisi bhi soorat mein wapas (non-refundable) nahi hogi.
                    </li>
                    <li class="list-group-item py-3">
                        <i class="fas fa-check-circle text-success me-2"></i> <strong>Attendance Policy:</strong> Course certificate ke liye classes mein 80% attendance aur discipline ka hona sakht lazmi hai.
                    </li>
                    <li class="list-group-item py-3">
                        <i class="fas fa-check-circle text-success me-2"></i> <strong>Lab Property:</strong> Academy ke computers aur equipment ki hifazat karna har student ki zimmedari hai.
                    </li>
                </ul>

                <div class="text-center mt-4">
                    <a href="/Home/Admission" class="btn btn-primary btn-lg fw-bold px-5">Proceed To Admission Form</a>
                </div>
            </div>
        </div>
    </div>
</div>